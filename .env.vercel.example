# 🔐 Переменные окружения для Vercel
# Скопируйте эти значения в Vercel Dashboard:
# https://vercel.com/prrojectt/okurmen/settings/environment-variables

# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://username:password@ep-example.us-east-2.aws.neon.tech/okurmen?sslmode=require

# ============================================
# AUTHENTICATION (NextAuth)
# ============================================
# Ваш production URL после деплоя
NEXTAUTH_URL=https://okurmen.vercel.app

# Сгенерируйте секрет: openssl rand -base64 32
NEXTAUTH_SECRET=ваш-секретный-ключ-32-символа

# ============================================
# GOOGLE OAUTH
# ============================================
# Получите из Google Cloud Console
GOOGLE_CLIENT_ID=ваш-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=ваш-google-client-secret

# ============================================
# API URLs (после деплоя API)
# ============================================
NEXT_PUBLIC_API_URL=https://okurmen-api.vercel.app

# ============================================
# JWT SECRETS (для API)
# ============================================
JWT_SECRET=ваш-jwt-secret-ключ
JWT_REFRESH_SECRET=ваш-jwt-refresh-secret-ключ

# ============================================
# EMAIL (для 2FA на API)
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=ваш-email@gmail.com
EMAIL_PASSWORD=ваш-app-password

# ============================================
# OTHER URLS
# ============================================
WEB_URL=https://okurmen.vercel.app
ADMIN_URL=https://okurmen-admin.vercel.app
EMPLOYEE_URL=https://okurmen-employee.vercel.app
STUDENT_URL=https://okurmen-student.vercel.app

# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV=production
